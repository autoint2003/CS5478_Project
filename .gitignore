# Datasets and training outputs. Historical demo_results now live at
# results/archive/demo_results/, which is covered by results/.
# Use results/** (not results/) so selected report packages can be re-included.
data/
demo_results/
results/**

# Keep the lightweight final consolidation report package versioned.
!results/experiments/
!results/experiments/final_consolidation/
!results/experiments/final_consolidation/**

# Training / evaluation runtime artifacts (local only)
tb_logs/
tensorboard/
**/tb/
*.pt
*.pth
*.ckpt
wandb/

# Presentation / render outputs (keep on disk; do not version)
*.mp4
**/_frames_*/

# Local archives / editor backups (source trees are versioned instead)
*.zip
*.bak
*.bak_*

# MuJoCo
*.mjb
MUJOCO_LOG.TXT
