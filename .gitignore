results/diagnostics/**/figures/
results/diagnostics/**/videos/
results/diagnostics/**/*.npz
results/diagnostics/**/*.pkl
results/diagnostics/**/*.csv

# Canonical snapshots / eval ICs that the pipeline actually reads
!results/diagnostics/ballistic_recovery_transfer/raw/
!results/diagnostics/ballistic_recovery_transfer/raw/snap_early.pkl
!results/diagnostics/ballistic_recovery_transfer/raw/stages.json
!results/diagnostics/dynamic_airborne_recatch/raw/
!results/diagnostics/dynamic_airborne_recatch/raw/release_map_recatch.json
!results/eval_sets/airborne_offset_eval.npz

